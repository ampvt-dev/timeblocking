{
  "name": "blockwise",
  "private": true,
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "productName": "Blockwise",
  "version": "0.1.0",
  "description": "Blockwise: time blocking for macOS and Windows. Shows your current block, counts it down, and chimes and speaks at each transition.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Converge Signs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icons": "node scripts/make-icons.js",
    "test:e2e": "node test/e2e.mjs",
    "templates": "node scripts/make-templates.js"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.convergesigns.blockwise",
    "productName": "Blockwise",
    "copyright": "Converge Signs",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Blockwise ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Blockwise"
    },
    "publish": null
  }
}
