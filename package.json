{
  "name": "timeblock",
  "private": true,
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "productName": "Timeblock",
  "version": "0.1.0",
  "description": "Time-block focus timer: shows your current block, chimes and announces transitions.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Converge Signs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icons": "node scripts/make-icons.js",
    "test:e2e": "node test/e2e.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.convergesigns.timeblock",
    "productName": "Timeblock",
    "copyright": "Converge Signs",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "dmg": {
      "title": "Timeblock ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Timeblock"
    },
    "publish": null
  }
}
